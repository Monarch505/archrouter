# copy to $HOME/.archrouter/.env — never commit the real one
ARCHROUTER_PORT=20399
ARCHROUTER_HOST=127.0.0.1
ARCHROUTER_MODE=warp
# 1 = pool resets dead warp backends automatically; 0 = serve direct, never reset
# (use 0 on UDP-filtered networks where resets can never succeed, e.g. mobile data)
ARCHROUTER_AUTO_RESET=1
# seconds a 429/403-burned backend stays out of rotation while it re-handshakes
ARCHROUTER_QUARANTINE_SECS=300
# chroot/Android only: main table has no default route → sing-box can't
# auto-detect egress ("missing default interface" / "network unreachable").
# Pin it, e.g. ARCHROUTER_NET_IF=wlan0. Empty = auto-detect (normal Linux).
# ARCHROUTER_NET_IF=
# WARP peer port override (default 2408 from wgcf profile; Cloudflare also
# answers 500/4500 — try when an ISP filters 2408).
# ARCHROUTER_WG_PORT=
# ARCHROUTER_KEY=isi-bebas-untuk-client-lokal
# WARP_LICENSE=(opsional Warp+ dari app 1.1.1.1)

# Auth. The dashboard has a three-way switch: auto (require a key as soon as a
# usable one exists), on (always), off (never). It is stored in SQLite, so it
# survives restarts, and takes effect immediately. Keys are sent as
# `Authorization: Bearer <key>` or `x-archrouter-key: <key>`; ?key= is refused
# on purpose. While no enabled key exists the first-key endpoints stay open, so
# a fresh install cannot lock itself out.
# ARCHROUTER_KEY=sk-arch-...
# Overrides the stored mode for this process: 1 = always require, 0 = always
# open. Unset = use the stored mode.
# ARCHROUTER_REQUIRE_AUTH=1
# Origins allowed to call the API from a browser, comma separated. Empty = no
# CORS headers at all, which is the safe default for a loopback service.
# ARCHROUTER_CORS_ORIGIN=
# Per-model reasoning levels, JSON, merged over server/lib/modelCaps.js. Use it
# when upstream adds a model before the table knows about it.
# ARCHROUTER_MODEL_CAPS={"my-new-model":{"kind":"chat","reasoning":true,"efforts":["low","high"]}}
