# copy to $HOME/.archrouter/.env — never commit the real one
ARCHROUTER_PORT=20399
ARCHROUTER_HOST=127.0.0.1
ARCHROUTER_MODE=warp
# 1 = pool resets dead warp backends automatically; 0 = serve direct, never reset
# (use 0 on UDP-filtered networks where resets can never succeed, e.g. mobile data)
ARCHROUTER_AUTO_RESET=1
# seconds a 429/403-burned backend stays out of rotation while it re-handshakes
ARCHROUTER_QUARANTINE_SECS=300
# chroot/Android only: main table has no default route → sing-box can't
# auto-detect egress ("missing default interface" / "network unreachable").
# Pin it, e.g. ARCHROUTER_NET_IF=wlan0. Empty = auto-detect (normal Linux).
# ARCHROUTER_NET_IF=
# WARP peer port override (default 2408 from wgcf profile; Cloudflare also
# answers 500/4500 — try when an ISP filters 2408).
# ARCHROUTER_WG_PORT=
# ARCHROUTER_KEY=isi-bebas-untuk-client-lokal
# WARP_LICENSE=(opsional Warp+ dari app 1.1.1.1)
