#!/usr/bin/env bash
# archrouter — thin shim. The real runtime is archrouter.js (cross-OS Node:
# Linux / Termux / Windows). Kept as a shim so existing symlinks and scripts
# (`~/.local/bin/archrouter`, `$PREFIX/bin/archrouter`) keep working unchanged.
#
# NOTE on PATH: on Termux/Kali the node on PATH may be older than 22 and the
# system node crashes on node:sqlite. Export
#   PATH=/root/.local/bin:/root/.local/node/bin:$PATH
# before calling archrouter (same requirement as the previous bash launcher).
set -u

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$d/$src" ;;
  esac
done
dir="$(cd -P "$(dirname "$src")" && pwd)"

exec node "$dir/archrouter.js" "$@"